# Copy to .env. Minimum to run locally: MONGODB_URI, JWT_SECRET, ANTHROPIC_API_KEY
# (the defaults below use the in-memory legal store and offline hash embeddings).

NODE_ENV=development
PORT=4000
APP_NAME=JurisAI
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

MONGODB_URI=mongodb://localhost:27017/jurisai
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- LLM ---
# anthropic = Claude; gemini = Google Gemini; offline = labelled template drafts, no AI calls (dev only).
LLM_PROVIDER=anthropic
# Gemini (free key: aistudio.google.com). Free tier: Google may use prompts to improve its
# products, so test with dummy case data only; use the paid tier for real clients.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5
EXTRACTION_MODEL=claude-haiku-4-5
# Ignored for models that reject sampling params (e.g. claude-sonnet-5); used for e.g. claude-sonnet-4-6.
GENERATION_TEMPERATURE=0.2
GENERATION_EFFORT=high
GENERATION_MAX_TOKENS=32000
CITATION_SCAN_ENABLED=true
# Independent check that each cited source actually says what the draft claims.
SUPPORT_CHECK_ENABLED=true
SUPPORT_CHECK_MODEL=claude-haiku-4-5

# --- Retrieval ---
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0
# Dev: memory + hash. Production: pgvector + voyage (then run `npm run ingest`).
LEGAL_STORE=memory
EMBEDDING_PROVIDER=hash
# DATABASE_URL=postgres://jurisai:jurisai@localhost:5432/jurisai
# VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-law-2
EMBEDDING_DIM=1024

# --- Quotas / abuse limits ---
FREE_DRAFTS_PER_MONTH=3
PRO_DRAFTS_PER_MONTH=200
GENERATE_RATE_LIMIT_MAX=5
GENERATE_RATE_LIMIT_WINDOW_SECONDS=600

# --- Auth ---
# console prints sign-in codes to the server log (dev only). Production: ses + a verified sender.
EMAIL_PROVIDER=console
# EMAIL_FROM=JurisAI <no-reply@yourdomain.in>
AUTH_RATE_LIMIT_PER_IP=100
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Export (S3, private bucket; presigned download URLs) ---
AWS_REGION=ap-south-1
# S3_BUCKET=
# Local development only (IAM user "jurisai-dev"). On EC2, attach an IAM role instead: no keys on the server.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# --- Razorpay ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PRO_TOTAL_COUNT=12
