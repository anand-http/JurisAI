# /opt/jurisai/.env on the server (chmod 600, owned by jurisai). Never commit real values.
# The app refuses to start in production with dev-only settings (hash embeddings,
# memory store, offline drafting, console email), so every service below must be set up.
NODE_ENV=production
PORT=4000
APP_NAME=JurisAI
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

MONGODB_URI=
JWT_SECRET=                         # openssl rand -hex 32

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5
EXTRACTION_MODEL=claude-haiku-4-5
SUPPORT_CHECK_MODEL=claude-haiku-4-5

LEGAL_STORE=pgvector
DATABASE_URL=postgres://<app user>:<password>@localhost:5432/JurisAi
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

EMAIL_PROVIDER=ses
EMAIL_FROM=JurisAI <no-reply@yourdomain.in>
AWS_REGION=ap-south-1
S3_BUCKET=                          # private bucket; access via the EC2 instance's IAM role

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=

FREE_DRAFTS_PER_MONTH=3
PRO_DRAFTS_PER_MONTH=50
